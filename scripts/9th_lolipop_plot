library(dplyr)
library(ggplot2)

meanTPM <- All_Species %>%
  group_by(Species) %>%
  summarise(
    MeanTPM = mean(TPM, na.rm = TRUE),
    .groups = "drop"
  )

ggplot(meanTPM,
       aes(x = reorder(Species, MeanTPM),
           y = MeanTPM)) +

  geom_segment(aes(xend = Species,
                   y = 0,
                   yend = MeanTPM),
               linewidth = 1,
               color = "grey60") +

  geom_point(size = 5,
             color = "steelblue") +

  coord_flip() +

  labs(
    title = "Mean Gene Expression by Species",
    x = "Species",
    y = "Mean TPM"
  ) +

  theme_minimal() +

  theme(
    plot.title = element_text(face = "bold", hjust = 0.5)
  )

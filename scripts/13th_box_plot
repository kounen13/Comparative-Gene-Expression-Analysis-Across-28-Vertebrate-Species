library(ggplot2)
library(dplyr)

# Sample data for faster plotting
set.seed(123)

sample_data <- All_Species %>%
  sample_n(20000)

ggplot(sample_data,
       aes(x = Species,
           y = log1p(TPM),
           fill = Species)) +
  
  geom_boxplot(
    width = 0.6,
    outlier.shape = NA,
    alpha = 0.7
  ) +
  
  geom_jitter(
    aes(color = Species),
    width = 0.2,
    alpha = 0.25,
    size = 0.6,
    show.legend = FALSE
  ) +
  
  stat_summary(
    fun = mean,
    geom = "point",
    shape = 23,
    size = 3,
    fill = "yellow",
    color = "black"
  ) +
  
  labs(
    title = "Distribution of Gene Expression Across Species",
    subtitle = "Boxplot with individual observations",
    x = "Species",
    y = "log(1 + TPM)"
  ) +
  
  theme_minimal() +
  
  theme(
    plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
    plot.subtitle = element_text(hjust = 0.5),
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "none"
  )

library(ggplot2)

ggplot(All_Species,
       aes(Species, TPM, fill = Species)) +
  geom_boxplot(outlier.size = 0.3) +
  scale_y_log10() +
  labs(
    title = "TPM Distribution Across Species",
    y = "TPM (log10)"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

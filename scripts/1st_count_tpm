library(readr)

All_Species <- read_csv("put location")

library(ggplot2)

ggplot(All_Species, aes(x = Species, fill = Species)) +
  geom_bar() +
  labs(
    title = "Number of Gene Expression Records per Species",
    x = "Species",
    y = "Number of Records"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1)
  )
